# Session signing secret (preferred). Falls back to SITE_PASSWORD if unset.
AUTH_SECRET=generate-a-long-random-string

# Admin account (case-insensitive). Gets unlimited companies + 10MB storage.
ADMIN_EMAIL=imrn.dev@gmail.com

# Optional: create admin user on first boot if Redis is configured
ADMIN_BOOTSTRAP_PASSWORD=

# Legacy site password — still unlocks admin (requires ADMIN_EMAIL)
SITE_PASSWORD=change-me

# Upstash Redis (required for multi-user persistence)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
