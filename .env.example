# Session signing secret (required in production).
AUTH_SECRET=generate-a-long-random-string

# Admin account (case-insensitive). Gets unlimited companies + 10MB storage.
ADMIN_EMAIL=imrn.dev@gmail.com

# Optional: create admin user on first boot if Redis is configured
ADMIN_BOOTSTRAP_PASSWORD=

# Deprecated: only used as the session-secret fallback when AUTH_SECRET is unset.
# The password-only admin login has been removed. Prefer AUTH_SECRET and drop this.
# SITE_PASSWORD=

# Upstash Redis (required for multi-user persistence)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Morning ingest (POST /api/ingest/daily). Bearer secret for agent/cron publish.
# Never commit the real value — set in Vercel / .env.local only.
HUNTER_INGEST_SECRET=

# Local dev / smoke only: in-process store instead of Upstash (ignored when VERCEL is set)
# HUNTER_MEMORY_REDIS=1
